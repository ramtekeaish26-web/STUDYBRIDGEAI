rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidLevel(val) {
      return val is string && val in ['Beginner', 'Intermediate', 'Advanced'];
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'email',
        'academicFocus',
        'defaultLevel',
        'defaultLanguage',
        'weeklyQuizGoal',
        'showInstantFeedback',
        'autoSaveLessons',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'displayName',
        'email',
        'academicFocus',
        'defaultLevel',
        'defaultLanguage',
        'weeklyQuizGoal',
        'showInstantFeedback',
        'autoSaveLessons',
        'createdAt',
        'updatedAt'
      ])
      && data.uid is string && data.uid == userId && data.uid.size() <= 128
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
      && data.email is string && data.email.size() <= 160
      && data.academicFocus is string && data.academicFocus.size() >= 1 && data.academicFocus.size() <= 120
      && isValidLevel(data.defaultLevel)
      && data.defaultLanguage is string && data.defaultLanguage.size() >= 1 && data.defaultLanguage.size() <= 40
      && data.weeklyQuizGoal is int && data.weeklyQuizGoal >= 1 && data.weeklyQuizGoal <= 100
      && data.showInstantFeedback is bool
      && data.autoSaveLessons is bool
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidLesson(data, userId, lessonId) {
      return data.keys().hasAll([
        'id',
        'uid',
        'topic',
        'title',
        'subject',
        'level',
        'language',
        'readMinutes',
        'summary',
        'definition',
        'coreMechanism',
        'examples',
        'analogies',
        'keyTakeaways',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'id',
        'uid',
        'topic',
        'title',
        'subject',
        'level',
        'language',
        'readMinutes',
        'summary',
        'definition',
        'coreMechanism',
        'examples',
        'analogies',
        'keyTakeaways',
        'groundedSources',
        'sourceNoteName',
        'isAiGenerated',
        'createdAt',
        'updatedAt'
      ])
      && data.id is string && data.id == lessonId && isValidId(data.id)
      && data.uid is string && data.uid == userId && data.uid.size() <= 128
      && data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 160
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 220
      && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 80
      && isValidLevel(data.level)
      && data.language is string && data.language.size() >= 1 && data.language.size() <= 40
      && data.readMinutes is int && data.readMinutes >= 1 && data.readMinutes <= 120
      && data.summary is string && data.summary.size() <= 1500
      && data.definition is string && data.definition.size() <= 2500
      && data.coreMechanism is list && data.coreMechanism.size() <= 20
      && (data.coreMechanism.size() == 0 || data.coreMechanism[0] is string)
      && data.examples is list && data.examples.size() <= 10
      && data.analogies is list && data.analogies.size() <= 10
      && data.keyTakeaways is list && data.keyTakeaways.size() <= 15
      && (data.keyTakeaways.size() == 0 || data.keyTakeaways[0] is string)
      && (!('groundedSources' in data) || (data.groundedSources is list && data.groundedSources.size() <= 10))
      && (!('sourceNoteName' in data) || (data.sourceNoteName is string && data.sourceNoteName.size() <= 160))
      && (!('isAiGenerated' in data) || data.isAiGenerated is bool)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidMastery(data, userId, topicId) {
      return data.keys().hasAll([
        'id',
        'uid',
        'topic',
        'subject',
        'correctAnswers',
        'attemptedQuestions',
        'strongConcepts',
        'weakConcepts',
        'revisionAdvice',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'id',
        'uid',
        'topic',
        'subject',
        'correctAnswers',
        'attemptedQuestions',
        'previousScorePercent',
        'latestScorePercent',
        'strongConcepts',
        'weakConcepts',
        'revisionAdvice',
        'lastPracticedAt',
        'updatedAt'
      ])
      && data.id is string && data.id == topicId && isValidId(data.id)
      && data.uid is string && data.uid == userId && data.uid.size() <= 128
      && data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 160
      && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 80
      && data.correctAnswers is int && data.correctAnswers >= 0 && data.correctAnswers <= 100
      && data.attemptedQuestions is int && data.attemptedQuestions >= 0 && data.attemptedQuestions <= 100
      && (!('previousScorePercent' in data) || data.previousScorePercent == null || (data.previousScorePercent is int && data.previousScorePercent >= 0 && data.previousScorePercent <= 100))
      && (!('latestScorePercent' in data) || data.latestScorePercent == null || (data.latestScorePercent is int && data.latestScorePercent >= 0 && data.latestScorePercent <= 100))
      && data.strongConcepts is list && data.strongConcepts.size() <= 25
      && data.weakConcepts is list && data.weakConcepts.size() <= 25
      && data.revisionAdvice is string && data.revisionAdvice.size() <= 600
      && (!('lastPracticedAt' in data) || data.lastPracticedAt == null || (data.lastPracticedAt is string && data.lastPracticedAt.size() <= 64))
      && data.updatedAt is timestamp;
    }

    function isValidQuizAttempt(data, userId, attemptId) {
      return data.keys().hasAll([
        'id',
        'uid',
        'topic',
        'correctCount',
        'totalQuestions',
        'scorePercent',
        'createdAt'
      ])
      && data.keys().hasOnly([
        'id',
        'uid',
        'topic',
        'correctCount',
        'totalQuestions',
        'scorePercent',
        'createdAt'
      ])
      && data.id is string && data.id == attemptId && isValidId(data.id)
      && data.uid is string && data.uid == userId && data.uid.size() <= 128
      && data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 160
      && data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 50
      && data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 50
      && data.scorePercent is int && data.scorePercent >= 0 && data.scorePercent <= 100
      && data.createdAt is timestamp;
    }

    function isValidFocusSession(data, userId, sessionId) {
      return data.keys().hasAll(['id', 'uid', 'durationMinutes', 'focusTopic', 'createdAt'])
      && data.keys().hasOnly(['id', 'uid', 'durationMinutes', 'focusTopic', 'createdAt'])
      && data.id is string && data.id == sessionId && isValidId(data.id)
      && data.uid is string && data.uid == userId && data.uid.size() <= 128
      && data.durationMinutes is int && data.durationMinutes >= 1 && data.durationMinutes <= 240
      && data.focusTopic is string && data.focusTopic.size() <= 160
      && data.createdAt is timestamp;
    }

    function isValidTutorThread(data, userId, threadId) {
      return data.keys().hasAll([
        'id',
        'uid',
        'title',
        'roleId',
        'modelId',
        'useSearchGrounding',
        'messages',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'id',
        'uid',
        'title',
        'roleId',
        'modelId',
        'useSearchGrounding',
        'messages',
        'createdAt',
        'updatedAt'
      ])
      && data.id is string && data.id == threadId && isValidId(data.id)
      && data.uid is string && data.uid == userId && data.uid.size() <= 128
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
      && data.roleId is string && data.roleId.size() >= 1 && data.roleId.size() <= 60
      && data.modelId is string && data.modelId.size() >= 1 && data.modelId.size() <= 60
      && data.useSearchGrounding is bool
      && data.messages is list && data.messages.size() <= 60
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidExperiment(data, userId, experimentId) {
      return data.keys().hasAll([
        'id',
        'uid',
        'question',
        'title',
        'domain',
        'summary',
        'predictions',
        'parameters',
        'outcomeExplanation',
        'realWorldApplications',
        'chartSeries',
        'createdAt'
      ])
      && data.keys().hasOnly([
        'id',
        'uid',
        'question',
        'title',
        'domain',
        'summary',
        'predictions',
        'parameters',
        'outcomeExplanation',
        'realWorldApplications',
        'chartSeries',
        'isAiGenerated',
        'createdAt'
      ])
      && data.id is string && data.id == experimentId && isValidId(data.id)
      && data.uid is string && data.uid == userId && data.uid.size() <= 128
      && data.question is string && data.question.size() >= 1 && data.question.size() <= 300
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
      && data.domain is string && data.domain.size() >= 1 && data.domain.size() <= 100
      && data.summary is string && data.summary.size() <= 1500
      && data.predictions is list && data.predictions.size() <= 10
      && data.parameters is list && data.parameters.size() <= 10
      && data.outcomeExplanation is list && data.outcomeExplanation.size() <= 15
      && data.realWorldApplications is list && data.realWorldApplications.size() <= 10
      && data.chartSeries is list && data.chartSeries.size() <= 15
      && (!('isAiGenerated' in data) || data.isAiGenerated is bool)
      && data.createdAt is timestamp;
    }

    function isValidStudyRoom(data, roomId) {
      return data.keys().hasAll([
        'id',
        'roomCode',
        'ownerUid',
        'ownerName',
        'title',
        'domain',
        'problemStatement',
        'targetCommunity',
        'constraints',
        'solutionSummary',
        'feasibilityScore',
        'aiIntegrationPlan',
        'buildPhases',
        'impactMetrics',
        'tasks',
        'risks',
        'visibility',
        'memberUids',
        'endorseUids',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'id',
        'roomCode',
        'ownerUid',
        'ownerName',
        'title',
        'domain',
        'problemStatement',
        'targetCommunity',
        'constraints',
        'linkedTopic',
        'solutionSummary',
        'feasibilityScore',
        'aiIntegrationPlan',
        'buildPhases',
        'impactMetrics',
        'tasks',
        'risks',
        'visibility',
        'memberUids',
        'endorseUids',
        'isAiGenerated',
        'createdAt',
        'updatedAt'
      ])
      && data.id is string && data.id == roomId && isValidId(data.id)
      && data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 12 && data.roomCode.matches('^[A-Z0-9]+$')
      && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
      && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 80
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
      && data.domain is string && data.domain.size() >= 1 && data.domain.size() <= 100
      && data.problemStatement is string && data.problemStatement.size() >= 1 && data.problemStatement.size() <= 1200
      && data.targetCommunity is string && data.targetCommunity.size() >= 1 && data.targetCommunity.size() <= 240
      && data.constraints is string && data.constraints.size() <= 600
      && (!('linkedTopic' in data) || (data.linkedTopic is string && data.linkedTopic.size() <= 160))
      && data.solutionSummary is string && data.solutionSummary.size() >= 1 && data.solutionSummary.size() <= 1800
      && data.feasibilityScore is int && data.feasibilityScore >= 0 && data.feasibilityScore <= 100
      && data.aiIntegrationPlan is string && data.aiIntegrationPlan.size() <= 1500
      && data.buildPhases is list && data.buildPhases.size() <= 10
      && data.impactMetrics is list && data.impactMetrics.size() <= 10
      && data.tasks is list && data.tasks.size() <= 20
      && data.risks is list && data.risks.size() <= 10
      && data.visibility is string && data.visibility in ['open', 'invite']
      && data.memberUids is list && data.memberUids.size() <= 20
      && (data.memberUids.size() == 0 || data.memberUids[0] is string)
      && data.endorseUids is list && data.endorseUids.size() <= 25
      && (data.endorseUids.size() == 0 || data.endorseUids[0] is string)
      && (!('isAiGenerated' in data) || data.isAiGenerated is bool)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidRoomContribution(data, roomId, contributionId) {
      return data.keys().hasAll([
        'id',
        'roomId',
        'roomOwnerUid',
        'roomVisibility',
        'authorUid',
        'authorName',
        'kind',
        'text',
        'createdAt'
      ])
      && data.keys().hasOnly([
        'id',
        'roomId',
        'roomOwnerUid',
        'roomVisibility',
        'authorUid',
        'authorName',
        'kind',
        'text',
        'createdAt'
      ])
      && data.id is string && data.id == contributionId && isValidId(data.id)
      && data.roomId is string && data.roomId == roomId && isValidId(data.roomId)
      && data.roomOwnerUid is string && data.roomOwnerUid.size() >= 1 && data.roomOwnerUid.size() <= 128
      && data.roomVisibility is string && data.roomVisibility in ['open', 'invite']
      && data.authorUid is string && data.authorUid == request.auth.uid && data.authorUid.size() <= 128
      && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
      && data.kind is string && data.kind in ['peer-idea', 'ai-critique', 'milestone']
      && data.text is string && data.text.size() >= 1 && data.text.size() <= 1500
      && data.createdAt is timestamp;
    }

    function canContributeToRoom(roomId, data) {
      let room = get(/databases/$(database)/documents/studyRooms/$(roomId)).data;
      return data.roomOwnerUid == room.ownerUid
        && data.roomVisibility == room.visibility
        && (room.visibility == 'open' || room.ownerUid == request.auth.uid || request.auth.uid in room.memberUids);
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'email',
          'academicFocus',
          'defaultLevel',
          'defaultLanguage',
          'weeklyQuizGoal',
          'showInstantFeedback',
          'autoSaveLessons',
          'updatedAt'
        ]);
      allow delete: if false;

      match /lessons/{lessonId} {
        allow get: if isValidId(userId) && isValidId(lessonId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(lessonId)
          && isVerifiedOwner(userId)
          && isValidLesson(incoming(), userId, lessonId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(lessonId)
          && isVerifiedOwner(userId)
          && isValidLesson(incoming(), userId, lessonId)
          && incoming().uid == existing().uid
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'topic',
            'title',
            'subject',
            'level',
            'language',
            'readMinutes',
            'summary',
            'definition',
            'coreMechanism',
            'examples',
            'analogies',
            'keyTakeaways',
            'groundedSources',
            'sourceNoteName',
            'isAiGenerated',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(lessonId) && isVerifiedOwner(userId);
      }

      match /mastery/{topicId} {
        allow get: if isValidId(userId) && isValidId(topicId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(topicId)
          && isVerifiedOwner(userId)
          && isValidMastery(incoming(), userId, topicId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(topicId)
          && isVerifiedOwner(userId)
          && isValidMastery(incoming(), userId, topicId)
          && incoming().uid == existing().uid
          && incoming().id == existing().id
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'topic',
            'subject',
            'correctAnswers',
            'attemptedQuestions',
            'previousScorePercent',
            'latestScorePercent',
            'strongConcepts',
            'weakConcepts',
            'revisionAdvice',
            'lastPracticedAt',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(topicId) && isVerifiedOwner(userId);
      }

      match /quizAttempts/{attemptId} {
        allow get: if isValidId(userId) && isValidId(attemptId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(attemptId)
          && isVerifiedOwner(userId)
          && isValidQuizAttempt(incoming(), userId, attemptId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(attemptId) && isVerifiedOwner(userId);
      }

      match /focusSessions/{sessionId} {
        allow get: if isValidId(userId) && isValidId(sessionId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(sessionId)
          && isVerifiedOwner(userId)
          && isValidFocusSession(incoming(), userId, sessionId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(sessionId) && isVerifiedOwner(userId);
      }

      match /tutorThreads/{threadId} {
        allow get: if isValidId(userId) && isValidId(threadId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(threadId)
          && isVerifiedOwner(userId)
          && isValidTutorThread(incoming(), userId, threadId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(threadId)
          && isVerifiedOwner(userId)
          && isValidTutorThread(incoming(), userId, threadId)
          && incoming().uid == existing().uid
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'roleId',
            'modelId',
            'useSearchGrounding',
            'messages',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(threadId) && isVerifiedOwner(userId);
      }

      match /experiments/{experimentId} {
        allow get: if isValidId(userId) && isValidId(experimentId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(experimentId)
          && isVerifiedOwner(userId)
          && isValidExperiment(incoming(), userId, experimentId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(experimentId) && isVerifiedOwner(userId);
      }
    }

    match /studyRooms/{roomId} {
      allow get: if isValidId(roomId)
        && isSignedIn()
        && (resource.data.visibility == 'open'
          || resource.data.ownerUid == request.auth.uid
          || request.auth.uid in resource.data.memberUids);
      allow list: if isSignedIn()
        && (resource.data.visibility == 'open'
          || resource.data.ownerUid == request.auth.uid
          || request.auth.uid in resource.data.memberUids);
      allow create: if isValidId(roomId)
        && isVerifiedUser()
        && isValidStudyRoom(incoming(), roomId)
        && incoming().ownerUid == request.auth.uid
        && incoming().memberUids.size() == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(roomId)
        && isVerifiedUser()
        && isValidStudyRoom(incoming(), roomId)
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().roomCode == existing().roomCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            request.auth.uid == existing().ownerUid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'domain',
              'problemStatement',
              'targetCommunity',
              'constraints',
              'linkedTopic',
              'solutionSummary',
              'feasibilityScore',
              'aiIntegrationPlan',
              'buildPhases',
              'impactMetrics',
              'tasks',
              'risks',
              'visibility',
              'updatedAt'
            ])
          )
          ||
          (
            request.auth.uid != existing().ownerUid
            && existing().visibility == 'open'
            && !(request.auth.uid in existing().memberUids)
            && incoming().memberUids.hasAll(existing().memberUids)
            && request.auth.uid in incoming().memberUids
            && incoming().memberUids.size() == existing().memberUids.size() + 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
          )
          ||
          (
            (existing().visibility == 'open' || request.auth.uid in existing().memberUids)
            && incoming().diff(existing()).affectedKeys().hasOnly(['tasks', 'updatedAt'])
          )
          ||
          (
            (existing().visibility == 'open' || request.auth.uid in existing().memberUids)
            && incoming().diff(existing()).affectedKeys().hasOnly(['endorseUids', 'updatedAt'])
            && (
              (
                !(request.auth.uid in existing().endorseUids)
                && incoming().endorseUids.hasAll(existing().endorseUids)
                && request.auth.uid in incoming().endorseUids
                && incoming().endorseUids.size() == existing().endorseUids.size() + 1
              )
              ||
              (
                (request.auth.uid in existing().endorseUids)
                && existing().endorseUids.hasAll(incoming().endorseUids)
                && !(request.auth.uid in incoming().endorseUids)
                && incoming().endorseUids.size() + 1 == existing().endorseUids.size()
              )
            )
          )
        );
      allow delete: if isValidId(roomId)
        && isVerifiedUser()
        && existing().ownerUid == request.auth.uid;

      match /contributions/{contributionId} {
        allow get: if isValidId(roomId)
          && isValidId(contributionId)
          && isSignedIn()
          && (resource.data.roomVisibility == 'open'
            || resource.data.authorUid == request.auth.uid
            || resource.data.roomOwnerUid == request.auth.uid
            || request.auth.uid in get(/databases/$(database)/documents/studyRooms/$(roomId)).data.memberUids);
        allow list: if isSignedIn()
          && (resource.data.roomVisibility == 'open'
            || resource.data.authorUid == request.auth.uid
            || resource.data.roomOwnerUid == request.auth.uid
            || request.auth.uid in get(/databases/$(database)/documents/studyRooms/$(roomId)).data.memberUids);
        allow create: if isValidId(roomId)
          && isValidId(contributionId)
          && isVerifiedUser()
          && isValidRoomContribution(incoming(), roomId, contributionId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/studyRooms/$(roomId))
          && canContributeToRoom(roomId, incoming());
        allow update: if false;
        allow delete: if isValidId(roomId)
          && isValidId(contributionId)
          && isVerifiedUser()
          && (existing().authorUid == request.auth.uid || existing().roomOwnerUid == request.auth.uid);
      }
    }
  }
}
